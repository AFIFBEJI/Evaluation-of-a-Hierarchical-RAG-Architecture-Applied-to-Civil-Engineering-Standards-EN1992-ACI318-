# Secrets — never commit
.env

# Python
__pycache__/
*.pyc
*.pyo

# ChromaDB local database (local only — too large for git)
structrag/data/chroma_db/

# Raw documents (licensing restrictions)
structrag/data/raw_standards/
structrag/data/raw_textbooks/
*.pdf

# Large parsed/chunk data files (reproducible from the PDF via run_pipeline.py)
structrag/data/parsed/
structrag/data/chunks/

# Logs and temp files
*.log
*.txt~
eval_stdout.txt
eval_stderr.txt
